{:tasks
 {:requires ([babashka.fs :as fs]
             [clojure.string :as str])

  :enter (println "Running task:" (:name (current-task)))

  ;; --- bench corpora -------------------------------------------------------
  ;; Pinned by commit, not by branch: a re-run months from now has to measure
  ;; the same code, or the numbers in docs/MEMORY.md compare nothing.
  :init (do
          (def bench-order ["metabase" "clj-kondo"])

          (def bench-corpora
            {"metabase" {:url "https://github.com/metabase/metabase"
                         :sha "42a8e9f77d330c90c5a4d71927fed2823897f949"}
             "clj-kondo" {:url "https://github.com/clj-kondo/clj-kondo"
                          :sha "13a32d1caf6278b7e4a8c4ad4936d4fc33db6cf2"}})

          (defn bench-git
            "Runs git in `dir`, returning trimmed stdout, or nil when it fails."
            [dir & args]
            (let [{:keys [exit out]} (apply shell {:dir (str dir)
                                                   :out :string
                                                   :err :string
                                                   :continue true}
                                            "git" args)]
              (when (zero? exit) (str/trim out))))

          (defn bench-corpus!
            "The corpus checkout for `name`, at its pinned commit. Fetches only
             that commit (`--depth 1`), so the clone stays shallow and a re-pin
             costs one fetch rather than a re-clone."
            [name]
            (let [{:keys [url sha]} (or (get bench-corpora name)
                                        (do (binding [*out* *err*]
                                              (println "Unknown bench corpus:" name
                                                       "- known:" (str/join ", " bench-order)))
                                            (System/exit 1)))
                  dir (fs/absolutize (fs/path ".tmp/bench" name))]
              (when-not (fs/exists? (fs/path dir ".git"))
                (println "Creating the bench corpus at" (str dir) "...")
                (fs/create-dirs dir)
                (shell {:dir (str dir)} "git init -q")
                (shell {:dir (str dir)} "git remote add origin" url))
              (when-not (= sha (bench-git dir "rev-parse" "HEAD"))
                (println "Fetching" name "at" sha "...")
                (shell {:dir (str dir)} "git fetch --depth 1 -q origin" sha)
                (shell {:dir (str dir)} "git checkout -q --detach FETCH_HEAD"))
              dir))
          nil)

  fmt-check {:doc "Check code formatting"
             :task (shell "cargo fmt --all -- --check")}

  fmt {:doc "Fix code formatting"
       :task (shell "cargo fmt --all")}

  lint {:doc "Lint code"
        :task (shell "cargo clippy --all-targets -- -D warnings")}

  test {:doc "Run tests"
        :task (shell "cargo test")}

  e2e {:doc "End-to-end tests (spawns real binary, speaks LSP over stdio)"
       :task (shell "cargo test --test test_e2e")}

  bench {:doc "Bench against pinned real Clojure repos: `bb bench metabase`, `bb bench clj-kondo`, or no argument for both (checked out under .tmp/bench on first run)"
         :task (doseq [name (or (seq *command-line-args*) bench-order)]
                 (let [dir (bench-corpus! name)]
                   ;; --release: the debug build's numbers are not what users see.
                   (shell {:extra-env {"CLJ_PULSE_BENCH_ROOT" (str dir)
                                       "CLJ_PULSE_BENCH_CORPUS" name}}
                          "cargo test --release --test test_bench -- --ignored --nocapture")))}

  e2e-real {:doc "E2E against a real Maven classpath (needs clojure CLI + network)"
            :task (shell "cargo test --test test_e2e -- --ignored")}

  e2e-real-kondo {:doc "E2E against a real clj-kondo binary (skips when not installed)"
                  :task (shell "cargo test --test test_e2e real_kondo -- --ignored")}

  e2e-nvim {:doc "Real-editor-client e2e via headless Neovim (needs the clojure CLI: the jar: check navigates into a real JAR)"
            :task (do (shell "cargo build")
                      ;; Resolve the fixture's classpath first, the way the
                      ;; Clojure Pulse runner does: without a `.cpcache` the
                      ;; server reaches the clojure JAR through stage 3, which
                      ;; announces itself with a different log line.
                      (shell {:dir "tests/fixtures/simple_project" :out :string} "clojure -Spath")
                      (shell "nvim --headless -l scripts/e2e_nvim.lua tests/fixtures/simple_project target/debug/clj-pulse"))}

  e2e-calva {:doc "Full-stack e2e: real VS Code + Calva under Xvfb (needs npm install in scripts/calva-e2e)"
             :task (do (shell "cargo build")
                       (shell {:dir "scripts/calva-e2e"} "xvfb-run -a node runner.js"))}

  e2e-pulse {:doc "Full-stack e2e: real VS Code + the Clojure Pulse extension under Xvfb (packages ../clojure-pulse-vscode when present, else the latest release; needs npm install in scripts/pulse-e2e)"
             :task (do (shell "cargo build")
                       (shell {:dir "scripts/pulse-e2e"} "xvfb-run -a node runner.js"))}

  ;; fmt-check, not fmt: this is the gate CI runs (the `lint-fmt` job), so it
  ;; must fail on unformatted code rather than quietly rewriting it and passing.
  ;; `bb fmt` is the fixer.
  check {:doc "Run all code checks and tests (formatting is checked, not fixed)"
         :depends [fmt-check lint test]}

  outdated {:doc "Check for outdated dependencies"
            :task (shell "cargo outdated")}

  gen-letgo-natives {:doc "Regenerate src/handlers/letgo_native_names.rs from the installed lg runtime (dev-only, offline; needs the lg binary)"
                     :task (shell "bash scripts/gen_letgo_native_names.sh")}

  build {:doc "Build application binary"
         :task (shell "cargo build")}
  
  release {:doc "Build application release binary"
           :task (shell "cargo build --release")}

  tag {:doc "Tag HEAD as v<version from Cargo.toml> and push to origin (triggers release CI)"
       :task (let [version (second (re-find (re-pattern "(?m)^version\\s*=\\s*\"([^\"]+)\"")
                                            (slurp "Cargo.toml")))]
               (when-not version
                 (binding [*out* *err*]
                   (println "Could not read version from Cargo.toml"))
                 (System/exit 1))
               (let [tag (str "v" version)]
                 (println "Tagging" tag "and pushing to origin...")
                 (shell "git tag" tag)
                 (shell "git push origin" tag)))}}}
